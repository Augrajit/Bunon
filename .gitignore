# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data that must never be public (PLAN.md v2 change 6)
data/raw/
data/private/
# Real order documents (real company names, PO numbers, SKUs, email, address): never commit, never send to the LLM.
# Both spellings, because Git on Windows ignores case but on Linux/macOS it does not.
data/documents/
data/Documents/
# Any PDF under data/ (none is published)
data/**/*.pdf

# Secrets
.env
.streamlit/secrets.toml

# Local tooling
.claude/

# Runtime approval log (ephemeral)
data/runtime/

# Full-size source photos (only the resized copy in assets/ is published)
data/image/
